<mvc:View controllerName="certificados.ccb.org.ccbcertvolantes.controller.Viewini"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:form="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">
        <content>
            <form:SimpleForm id="formVolante"
                editable="true"
                layout="ResponsiveGridLayout"
                labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
                emptySpanXL="4" emptySpanL="4" emptySpanM="2" emptySpanS="0"
                columnsXL="1" columnsL="1" columnsM="1">

                <core:Title text="Datos del Empleado" />

                <Label text="Número de Empleado" />
                <Input id="inpPernr" value="{globalData>/userData/d/Pernr}" editable="false" />

                <Label text="Nombre" />
                <Input id="inpNombre" value="{globalData>/userData/d/Nombre}" editable="false" />

                <Label text="Área de Nómina" />
                <Input id="inpAreaNom" value="{globalData>/userData/d/Area_Nom}" editable="false" />

                <Label text="Otro Numero de personal" />
                <Input id="inpOtroPernr"
                    value="{viewiniView>/otroPernr}"
                    type="Number"
                    maxLength="8"
                    liveChange="onOtroPernrLiveChange"
                    change="onOtroPernrChange"
                    visible="{= ${globalData>/userData/d/TienePermiso} === true }"
                    editable="{= ${globalData>/userData/d/TienePermiso} === true }" />

                <core:Title text="Parámetros del Volante" />

                <Label text="Periodo" required="true" />
                <Select id="selPeriodo" selectedKey="{viewiniView>/periodo}" required="true" forceSelection="false" change="onPeriodoAnioChange">
                    <core:Item key="01" text="01" />
                    <core:Item key="02" text="02" />
                    <core:Item key="03" text="03" />
                    <core:Item key="04" text="04" />
                    <core:Item key="05" text="05" />
                    <core:Item key="06" text="06" />
                    <core:Item key="07" text="07" />
                    <core:Item key="08" text="08" />
                    <core:Item key="09" text="09" />
                    <core:Item key="10" text="10" />
                    <core:Item key="11" text="11" />
                    <core:Item key="12" text="12" />
                </Select>

                <Label text="Año" required="true" />
                <Select id="selAnio" selectedKey="{viewiniView>/anio}" items="{globalData>/aniosVolante}" required="true" forceSelection="false" change="onPeriodoAnioChange">
                    <core:Item key="{globalData>Anio}" text="{globalData>DescAnio}" />
                </Select>

                <Label text="Tipo Pago" required="true" />
                <Select id="selTipoPago" selectedKey="{viewiniView>/tipoPago}" items="{viewiniView>/tiposPago}" required="true" forceSelection="false" enabled="{= ${viewiniView>/tiposPago}.length > 0 }">
                    <core:Item key="{viewiniView>PayOcrsn}" text="{viewiniView>Descripcion}" />
                </Select>
            </form:SimpleForm>
        </content>
        <footer>
            <Bar>
                <contentRight>
                    <Button id="btnGenerar" text="GENERAR" type="Emphasized" press="onGenerarVolante" />
                </contentRight>
            </Bar>
        </footer>
    </Page>
</mvc:View>
